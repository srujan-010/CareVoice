# MongoDB Atlas Connection (Backend Only - NEVER expose to frontend)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB_NAME="carevoice"

# Server & Security
NODE_ENV="development"
PORT=4000
# Comma-separated frontend origins allowed by CORS (no trailing slash needed)
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="replace-with-strong-random-64-char-secret"
JWT_EXPIRES_IN="7d"
VOICE_AGENT_INTERNAL_TOKEN="replace-with-strong-voice-agent-service-token"

# Redis & BullMQ Scheduling (set REDIS_ENABLED=false if deploying without a Redis instance to use MongoDB recovery/polling)
REDIS_URL="redis://127.0.0.1:6379"
REDIS_ENABLED="false"

# Sarvam AI Voice Agent Instant Outbound API (Keep mock/false until go-live validation is complete)
VOICE_PROVIDER_MODE="mock"
TELEPHONY_ENABLED="false"
# Voice Agents Workspace API key from https://apps.sarvam.ai -> Settings -> API Key (NOT a dashboard.sarvam.ai Model API key)
SARVAM_API_KEY=""
SARVAM_API_BASE_URL="https://apps.sarvam.ai"
SARVAM_ORG_ID=""
SARVAM_WORKSPACE_ID=""
SARVAM_AGENT_ID=""
# Positive integer mapped to app_config.app_version in Sarvam Instant Outbound API (defaults to 1 if omitted)
SARVAM_AGENT_VERSION="2"
SARVAM_CONNECTION_ID=""
# Agent caller ID in strict E.164 format (e.g., +917965860596)
SARVAM_PHONE_NUMBER=""
# High-entropy secret token (min 24 chars, e.g., openssl rand -hex 32) embedded in webhook URL path
SARVAM_WEBHOOK_TOKEN=""
# Optional HMAC-SHA256 secret (only if a proxy/gateway explicitly injects X-Webhook-Signature)
SARVAM_WEBHOOK_SECRET=""
# Public HTTPS base URL where Sarvam POSTs call-completion webhooks (e.g., https://carevoice-backend.onrender.com)
PUBLIC_WEBHOOK_BASE_URL=""
# Optional comma-separated allowed languages on Sarvam agent (e.g., en,hi,te,ta,kn,ml,mr,gu,bn,pa,or)
SARVAM_ALLOWED_LANGUAGES=""
# Sarvam agent variable schema profile:
# "committed" = 8 existing Canvas variables (call_purpose, doctor_instructions, dosage, dose_number, food_instruction, meal, medicine_name, user_name)
# "extended" = 13 canonical variables (adds language_name, language_code, language_directive, associated_meal, slot_label once committed in Canvas)
SARVAM_AGENT_VARIABLE_PROFILE="committed"
# Optional explicit comma-separated override of custom agent_variables committed on your Sarvam agent version (or "none").
SARVAM_ALLOWED_AGENT_VARIABLES=""
# Optional JSON map of { "<sarvamVarName>": "<carevoiceCanonicalKey>" } when Sarvam Canvas uses custom variable names.
SARVAM_AGENT_VARIABLE_MAP=""

# Notification Adapters (Remain disabled unless credentials are configured)
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER_URL=""
WHATSAPP_API_TOKEN=""
SMS_ENABLED="false"
SMS_PROVIDER_URL=""
SMS_API_TOKEN=""

# Explicitly controls optional dev demo endpoints
ALLOW_DEV_DEMO_MODE="false"

# Frontend public URL (safe for browser)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

